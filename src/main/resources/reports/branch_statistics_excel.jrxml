    <!-- 4. DÒNG TỔNG CỘNG HỆ THỐNG (SUMMARY BAND) -->
    <summary>
        <band height="28" splitType="Stretch">
            <!-- Ô gộp Cột 1 đến Cột 4: "TỔNG CỘNG HỆ THỐNG" -->
            <staticText>
